# Copy to ".env" (same folder as urldetection.py) and fill it in.
# ".env" holds secrets: never commit it or share it, and restrict it:  chmod 600 .env
# The server warns at startup if the file is readable by other users.

# ---- Threat-intelligence API keys ------------------------------------------------------------
# Google Safe Browsing API key (free): https://developers.google.com/safe-browsing/v4/get-started
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable "Safe Browsing API"
# 3. APIs & Services > Credentials > Create credentials > API key
#    RESTRICT THE KEY to the Safe Browsing API (and to your server's IP if it has a fixed one).
# Without any key the scanner still runs, but every result is "Unable to verify"
# or "Suspicious" (URL-structure warnings only). It never reports "No known threat detected".
GOOGLE_SAFE_BROWSING_API_KEY=

# abuse.ch URLhaus Auth-Key (free, optional): https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# ---- Threat-lookup behaviour (defaults shown; out-of-range values are clamped) ----------------
THREAT_INTEL_CONNECT_TIMEOUT=3          # seconds to connect to a threat service (0.5 - 15)
THREAT_INTEL_READ_TIMEOUT=5             # seconds to wait for its answer (0.5 - 15)
LOOKUP_DEADLINE_SECONDS=10              # overall limit for all lookups in one scan (1 - 60)
THREAT_INTEL_CACHE_TTL_SECONDS=300      # cache hit/clear answers (never failures)
THREAT_INTEL_RATE_LIMIT_COOLDOWN=60     # pause a service this long after a rate-limit response
THREAT_INTEL_FAILURE_THRESHOLD=3        # consecutive timeouts/5xx before a short pause
THREAT_INTEL_FAILURE_PAUSE_SECONDS=30
# 1 = send the full address (including ?query) to the threat services: best detection.
# 0 = strip ?query and #fragment first: better privacy for links that carry tokens, fewer exact matches.
THREAT_INTEL_SEND_QUERY=1

# ---- Optional ML model -------------------------------------------------------------------------
# 1 = score addresses with the trained model in detection/ml_model.json, but ONLY if that file says "adopted": true, which
# `python evaluate.py --ml --report` writes only when every evidence gate passes (see reports/ml_evaluation.md). A model
# that failed its gates is ignored even with this set. The model can only add a "Suspicious" verdict; it never
# produces "Malicious" and never overrides a threat-database result.
ENABLE_ML_MODEL=0

# ---- Browser access ---------------------------------------------------------------------------
# Exact origins (scheme://host[:port]) allowed to call the API from another site. Comma-separated.
# "*" is never honoured. The bundled frontend is same-origin and needs nothing here.
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# DEVELOPMENT ONLY: allow the "null" origin (index.html opened from disk). Leave off anywhere real.
# ALLOW_NULL_ORIGIN=0
# Browser extension (the "extension/" folder). A browser sends "Origin: chrome-extension://<id>" with its checks.
# Exact origins only, comma-separated; wildcards are ignored. Listed extensions may use /scan and /health and nothing else,
# and their checks are not saved to scan history. The value below is the ID the bundled extension gets when you load it
# unpacked. If you publish your own build, add its ID. Set this to an empty value to turn extension access off.
# (The extension's Settings page shows the exact origin to add if yours differs.)
EXTENSION_ORIGINS=chrome-extension://pooegmoiedafmkppnjmddffjbkdepeke

# ---- Server -------------------------------------------------------------------------------------
# Use `python urldetection.py` on your own machine only. For deployment run `gunicorn wsgi:app`
# (or `waitress-serve wsgi:app` on Windows) behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=5000
# Never 1 in deployment. The server refuses to start with FLASK_DEBUG=1 unless HOST is 127.0.0.1.
FLASK_DEBUG=0
# Number of reverse proxies in front of the app. Leave 0 unless you run one: only then are
# X-Forwarded-For / -Proto / -Host believed (otherwise any client could fake its address).
TRUSTED_PROXY_COUNT=0
# Send "Strict-Transport-Security" (only meaningful when served over HTTPS).
HSTS=0
# Leave unset to decide per request (Secure when HTTPS). Set 1 to force Secure cookies.
# COOKIE_SECURE=1
# 1 = /health also reports which providers are configured (operator information).
HEALTH_DETAIL=0

# ---- Rate limits (per client address, per minute) ------------------------------------------
RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=600        # all clients together: protects your API quotas
API_RATE_LIMIT_PER_MINUTE=120
CONTACT_RATE_LIMIT_PER_MINUTE=5

# ---- Stored data ---------------------------------------------------------------------------------
# Scan history: scheme+host+path only, private to each browser (anonymous cookie), auto-deleted.
HISTORY_ENABLED=1
HISTORY_RETENTION_DAYS=30
HISTORY_MAX_PER_CLIENT=200
# Contact form: name, email and message, with consent. Stored in data/contact_messages.jsonl (mode 0600).
CONTACT_ENABLED=1
CONTACT_RETENTION_DAYS=90
CONTACT_MAX_BYTES=2000000

# ---- Production: logging, monitoring, startup checks (Stage 8) ----------------------------------
# production = log warnings at startup for settings that are risky on the public internet (no proxy count, no HSTS, no API
# key, ...) and refuse to start with FLASK_DEBUG=1. See docs/DEPLOYMENT.md.
# APP_ENV=production
# json = one JSON object per line (for a log shipper); text = readable lines for a terminal.
LOG_FORMAT=text
LOG_LEVEL=INFO
# One structured line per request: method, matched route, status, duration, request id. Never the address scanned, the
# query string, cookies or the client IP. Health checks are logged only at LOG_LEVEL=DEBUG.
LOG_REQUESTS=1
# GET /metrics (Prometheus text) is OFF unless this is set; send it as "Authorization: Bearer <token>". Use a long random value.
# METRICS_TOKEN=
# Docker/Kubernetes secrets: any key above can instead be read from a file, e.g.
# GOOGLE_SAFE_BROWSING_API_KEY_FILE=/run/secrets/gsb_key      URLHAUS_AUTH_KEY_FILE=...      METRICS_TOKEN_FILE=...

