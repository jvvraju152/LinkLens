# Copy to ".env" next to docker-compose.yml, then:  chmod 600 .env     (never commit it)
# Settings that make HTTPS deployment safe (APP_ENV, HSTS, COOKIE_SECURE, TRUSTED_PROXY_COUNT, CORS_ORIGINS) are set in
# docker-compose.yml. Every other option is documented in .env.example.

# Required: the public hostname Caddy gets a certificate for. DNS must already point here.
DOMAIN=scanner.example.com

# Threat-database keys. Without at least one, every scan is "Unable to verify" or "Suspicious".
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Monitoring: leave empty to switch GET /metrics off. Otherwise use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Rate limits per client address per minute (the app counts per process; Caddy passes the real client address on).
RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_PER_MINUTE=120
CONTACT_RATE_LIMIT_PER_MINUTE=5

# Privacy-leaning option: 0 strips ?query and #fragment before an address is sent to Google / URLhaus.
THREAT_INTEL_SEND_QUERY=1
