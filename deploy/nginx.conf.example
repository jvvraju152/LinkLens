# Alternative to Caddy: nginx in front of gunicorn (listening on 127.0.0.1:8000), with TLS from certbot.
# Set in .env:  TRUSTED_PROXY_COUNT=1  HSTS=1  COOKIE_SECURE=1  CORS_ORIGINS=https://scanner.example.com
# This is an example; adapt paths and the server_name, then run `nginx -t` before reloading. Not tested in CI.

# Proxy-level rate limits. The app's own limiter is per process, so this is the second line of defence.
limit_req_zone $binary_remote_addr zone=cs_scan:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=cs_api:10m rate=120r/m;
limit_req_status 429;

server {
    listen 80;
    server_name scanner.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name scanner.example.com;

    ssl_certificate     /etc/letsencrypt/live/scanner.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/scanner.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 32k;
    server_tokens off;

    # One proxy hop: overwrite (not append) the client address so it cannot be forged.
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_read_timeout 70s;

    location = /scan {
        limit_req zone=cs_scan burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location ~ ^/(history|contact|evaluation|privacy)(/|$) {
        limit_req zone=cs_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    # Metrics only from the monitoring host. The app also requires the bearer token.
    location = /metrics {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
